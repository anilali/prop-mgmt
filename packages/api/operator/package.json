{
  "name": "@moonship/api-operator",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "default": "./src/server.ts"
    },
    "./constants": {
      "types": "./src/constants.ts",
      "default": "./src/constants.ts"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc --watch --noEmit",
    "format": "prettier --check . --ignore-path ../../../.gitignore",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "test": "vitest run",
    "test:integration": "pnpm with-env vitest run -c vitest.integration.config.ts",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "with-env": "dotenv -e ../../../.env --"
  },
  "dependencies": {
    "@moonship/access": "workspace:*",
    "@moonship/billing": "workspace:*",
    "@moonship/blob-storage": "workspace:*",
    "@moonship/db": "workspace:*",
    "@moonship/events": "workspace:*",
    "@moonship/lease-mgmt": "workspace:*",
    "@moonship/property": "workspace:*",
    "@moonship/shared": "workspace:*",
    "@moonship/statement-pdf": "workspace:*",
    "@moonship/tenant-mgmt": "workspace:*",
    "@trpc/server": "catalog:",
    "papaparse": "^5.7.0",
    "superjson": "2.2.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@moonship/eslint-config": "workspace:*",
    "@moonship/prettier-config": "workspace:*",
    "@moonship/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/papaparse": "^5.5.2",
    "dotenv-cli": "^10.0.0",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "prettier": "@moonship/prettier-config"
}
