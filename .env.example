# Copy to `.env` and fill in secrets. Every script loads only this file.

# Neon Postgres, the prop-mgmt project's development branch (drop --pooled for the non-pooling URL):
#   neon connection-string development --project-id polished-violet-47795007 --pooled
POSTGRES_URL=""
POSTGRES_URL_NON_POOLING=""

# Neon Object Storage, the prop-mgmt-storage project's development branch:
#   neon env pull --project-id jolly-fog-99364648 --branch development -s object-storage --file .env
AWS_ENDPOINT_URL_S3=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION=""
S3_BUCKET="leases"

# Operator portal (http://localhost:3000)
OPERATOR_AUTH_SECRET="replace-with-openssl-rand-base64-32"
OPERATOR_GOOGLE_CLIENT_ID=""
OPERATOR_GOOGLE_CLIENT_SECRET=""
OPERATOR_BETTER_AUTH_URL="http://localhost:3000"

# Tenant portal (http://localhost:3001)
TENANT_AUTH_SECRET="replace-with-openssl-rand-base64-32"
TENANT_GOOGLE_CLIENT_ID=""
TENANT_GOOGLE_CLIENT_SECRET=""
TENANT_BETTER_AUTH_URL="http://localhost:3001"

# Optional e2e bypass
ENABLE_TEST_AUTH="0"
