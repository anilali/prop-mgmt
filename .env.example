# Copy to `.env` and fill in secrets. Every script loads only this file.

# Neon Postgres, the prop-mgmt project's development branch (drop --pooled for the non-pooling URL):
#   neon connection-string development --project-id polished-violet-47795007 --pooled
POSTGRES_URL=""
POSTGRES_URL_NON_POOLING=""

# Neon Object Storage, the prop-mgmt-storage project's development branch:
#   neon env pull --project-id jolly-fog-99364648 --branch development -s object-storage --file .env
AWS_ENDPOINT_URL_S3=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION=""
S3_BUCKET="leases"

# One Google OAuth client for both portals. Its authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   http://localhost:3001/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Operator portal (http://localhost:3000). Auth secret: openssl rand -base64 32
OPERATOR_AUTH_SECRET=""
OPERATOR_BETTER_AUTH_URL="http://localhost:3000"

# Tenant portal (http://localhost:3001). Auth secret: openssl rand -base64 32
TENANT_AUTH_SECRET=""
TENANT_BETTER_AUTH_URL="http://localhost:3001"

# Optional: act as if today is this date (YYYY-MM-DD). Ignored in production.
# TODAY_OVERRIDE="2027-01-05"
