# Copy to `.env` and fill in secrets.

# Local Postgres (Podman): `pnpm db:up`
POSTGRES_URL="postgres://propmgmt:propmgmt@localhost:5432/propmgmt"

# MinIO (S3-compatible) — started with `pnpm db:up`
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="propmgmt"
S3_SECRET_KEY="propmgmtsecret"
S3_BUCKET="propmgmt-leases"
S3_REGION="us-east-1"
S3_FORCE_PATH_STYLE="true"

# Operator portal (http://localhost:3000)
OPERATOR_AUTH_SECRET="replace-with-openssl-rand-base64-32"
OPERATOR_GOOGLE_CLIENT_ID=""
OPERATOR_GOOGLE_CLIENT_SECRET=""
OPERATOR_BETTER_AUTH_URL="http://localhost:3000"

# Tenant portal (http://localhost:3001)
TENANT_AUTH_SECRET="replace-with-openssl-rand-base64-32"
TENANT_GOOGLE_CLIENT_ID=""
TENANT_GOOGLE_CLIENT_SECRET=""
TENANT_BETTER_AUTH_URL="http://localhost:3001"

# Optional e2e bypass
ENABLE_TEST_AUTH="0"
